<?xml version="1.0" encoding="utf-8"?>

<!-- For more information on using web.config transformation visit https://go.microsoft.com/fwlink/?LinkId=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    Khi Publish ở cấu hình Release: tắt debug để website chạy nhanh hơn.
    Nếu server dùng SQL Server khác, sửa chuỗi kết nối bằng transform, ví dụ:

    <connectionStrings>
      <add name="RentHouseDBContext"
        connectionString="Data Source=TEN-SERVER;Initial Catalog=RentHouseDB;Integrated Security=True"
        xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
    </connectionStrings>
  -->
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
  </system.web>
</configuration>
