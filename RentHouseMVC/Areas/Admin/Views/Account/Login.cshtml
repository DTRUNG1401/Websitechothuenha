@model RentHouseMVC.Models.ViewModels.LoginViewModel
@{
    // Trang đăng nhập không dùng _AdminLayout
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Đăng nhập quản trị | RentHouse</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" href="~/Content/images/favicon.svg" type="image/svg+xml" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/theme.css" rel="stylesheet" />
    <link href="~/Content/admin.css" rel="stylesheet" />
</head>
<body class="login-page">
    <main class="login-card">
        <a class="login-brand" href="@Url.Action("Index", "Home", new { area = "" })">RentHouse</a>
        <h1>Đăng nhập quản trị</h1>
        <p class="text-muted small mb-4">Dành cho quản trị viên website.</p>

        @using (Html.BeginForm("Login", "Account", new { area = "Admin" }, FormMethod.Post, new { novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ReturnUrl)
            @Html.ValidationSummary(true, "")

            <div class="mb-3">
                @Html.LabelFor(m => m.Username, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Username, new { @class = "form-control", autofocus = "autofocus", autocomplete = "username", maxlength = "50" })
                @Html.ValidationMessageFor(m => m.Username)
            </div>

            <div class="mb-4">
                @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "current-password" })
                @Html.ValidationMessageFor(m => m.Password)
            </div>

            <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
        }

        <p class="login-back mb-0">
            <a href="@Url.Action("Index", "Home", new { area = "" })">Về trang chủ RentHouse</a>
        </p>
    </main>

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/Scripts/admin.js"></script>
</body>
</html>
