@{
    string adminName = (Session[SessionKeys.AdminFullName] as string) ?? "Quản trị viên";
    string adminUser = (Session[SessionKeys.AdminUsername] as string) ?? string.Empty;
    string controllerName = (ViewContext.RouteData.Values["controller"] as string) ?? string.Empty;
    string actionName = (ViewContext.RouteData.Values["action"] as string) ?? string.Empty;
    string pendingCount = Html.Action("PendingCount", "Dashboard", new { area = "Admin" }).ToString();
    bool hasPending = !string.IsNullOrEmpty(pendingCount) && pendingCount != "0";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewBag.Title | Quản trị RentHouse</title>
    <link rel="icon" href="~/Content/images/favicon.svg" type="image/svg+xml" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/Content/admin.css" rel="stylesheet" />
</head>
<body class="admin-body">
    <div class="admin-wrapper">
        <!-- ===== MENU BÊN TRÁI (máy tính: cố định; điện thoại: trượt ra) ===== -->
        <aside class="admin-sidebar">
            <div class="offcanvas-lg offcanvas-start admin-offcanvas" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel">
                <div class="offcanvas-header">
                    <span class="admin-brand" id="adminSidebarLabel">
                        <span class="brand-logo"><i class="bi bi-house-heart-fill"></i></span> RentHouse
                    </span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Đóng"></button>
                </div>
                <div class="offcanvas-body d-flex flex-column p-0 w-100">
                    <a class="admin-brand d-none d-lg-flex" href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">
                        <span class="brand-logo"><i class="bi bi-house-heart-fill"></i></span> RentHouse <small>Admin</small>
                    </a>
                    <nav class="admin-nav">
                        <div class="nav-label">Tổng quan</div>
                        <a class="nav-link @(controllerName == "Dashboard" ? "active" : "")" href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>

                        <div class="nav-label">Quản lý</div>
                        <a class="nav-link @(controllerName == "Category" ? "active" : "")" href="@Url.Action("Index", "Category", new { area = "Admin" })">
                            <i class="bi bi-tags"></i> Loại nhà
                        </a>
                        <a class="nav-link @(controllerName == "House" ? "active" : "")" href="@Url.Action("Index", "House", new { area = "Admin" })">
                            <i class="bi bi-houses"></i> Nhà cho thuê
                        </a>
                        <a class="nav-link @(controllerName == "RentalRequest" ? "active" : "")" href="@Url.Action("Index", "RentalRequest", new { area = "Admin" })">
                            <i class="bi bi-calendar-check"></i> Yêu cầu thuê
                            @if (hasPending)
                            {
                                <span class="badge rounded-pill text-bg-warning ms-auto" title="Yêu cầu chờ duyệt">@pendingCount</span>
                            }
                        </a>

                        <div class="nav-label">Tài khoản</div>
                        <a class="nav-link @(controllerName == "Account" && actionName == "ChangePassword" ? "active" : "")" href="@Url.Action("ChangePassword", "Account", new { area = "Admin" })">
                            <i class="bi bi-key"></i> Đổi mật khẩu
                        </a>
                        <a class="nav-link" href="@Url.Action("Index", "Home", new { area = "" })" target="_blank" rel="noopener">
                            <i class="bi bi-box-arrow-up-right"></i> Xem website
                        </a>
                    </nav>
                    <div class="mt-auto px-4 py-3 small sidebar-footer">RentHouse Admin &middot; ASP.NET MVC 5</div>
                </div>
            </div>
        </aside>

        <div class="admin-main">
            <!-- ===== THANH TRÊN ===== -->
            <header class="admin-topbar">
                <button class="btn btn-light d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="Mở menu">
                    <i class="bi bi-list"></i>
                </button>
                <h1 class="admin-page-title">@ViewBag.Title</h1>
                <div class="dropdown ms-auto">
                    <button class="btn btn-light d-flex align-items-center gap-2 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar">@adminName.Substring(0, 1).ToUpper()</span>
                        <span class="d-none d-sm-inline">@adminName</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                        <li><h6 class="dropdown-header">Tài khoản: @adminUser</h6></li>
                        <li>
                            <a class="dropdown-item" href="@Url.Action("ChangePassword", "Account", new { area = "Admin" })"><i class="bi bi-key me-2"></i>Đổi mật khẩu</a>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            @using (Html.BeginForm("Logout", "Account", new { area = "Admin" }, FormMethod.Post, new { id = "logoutForm" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                            }
                        </li>
                    </ul>
                </div>
            </header>

            <!-- ===== NỘI DUNG ===== -->
            <main class="admin-content">
                @Html.Partial("_Alerts")
                @RenderBody()
            </main>

            <footer class="admin-footer">
                &copy; @DateTime.Now.Year RentHouse &middot; Trang quản trị
            </footer>
        </div>
    </div>

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
    <script src="~/Scripts/admin.js"></script>
</body>
</html>
