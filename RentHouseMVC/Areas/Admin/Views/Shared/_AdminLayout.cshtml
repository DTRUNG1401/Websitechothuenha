@{
    string adminName = (Session[SessionKeys.AdminFullName] as string) ?? "Quản trị viên";
    string controllerName = (ViewContext.RouteData.Values["controller"] as string) ?? string.Empty;
    string actionName = (ViewContext.RouteData.Values["action"] as string) ?? string.Empty;
    string pendingCount = Html.Action("PendingCount", "Dashboard", new { area = "Admin" }).ToString();
    bool hasPending = !string.IsNullOrEmpty(pendingCount) && pendingCount != "0";
    bool isPassword = controllerName == "Account" && actionName == "ChangePassword";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewBag.Title | Quản trị RentHouse</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" href="~/Content/images/favicon.svg" type="image/svg+xml" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/Content/theme.css" rel="stylesheet" />
    <link href="~/Content/admin.css" rel="stylesheet" />
</head>
<body class="admin-body">
    <a class="skip-link" href="#admin-main">Bỏ qua đến nội dung chính</a>
    <div class="admin-wrapper">
        <!-- ===== MENU BÊN TRÁI (máy tính: cố định; điện thoại: khung trượt) ===== -->
        <aside class="admin-sidebar">
            <div class="offcanvas-lg offcanvas-start admin-offcanvas" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel">
                <div class="offcanvas-header border-bottom">
                    <h2 class="h6 mb-0" id="adminSidebarLabel">Menu quản trị</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Đóng menu"></button>
                </div>
                <div class="offcanvas-body d-flex flex-column p-0 w-100">
                    <a class="admin-brand" href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">
                        RentHouse
                        <small>Trang quản trị</small>
                    </a>
                    <nav class="admin-nav" aria-label="Menu quản trị">
                        <a class="nav-link @(controllerName == "Dashboard" ? "active" : "")" href="@Url.Action("Index", "Dashboard", new { area = "Admin" })" aria-current="@(controllerName == "Dashboard" ? "page" : null)">Tổng quan</a>

                        <div class="nav-label">Quản lý</div>
                        <a class="nav-link @(controllerName == "Category" ? "active" : "")" href="@Url.Action("Index", "Category", new { area = "Admin" })" aria-current="@(controllerName == "Category" ? "page" : null)">Loại nhà</a>
                        <a class="nav-link @(controllerName == "House" ? "active" : "")" href="@Url.Action("Index", "House", new { area = "Admin" })" aria-current="@(controllerName == "House" ? "page" : null)">Nhà cho thuê</a>
                        <a class="nav-link @(controllerName == "RentalRequest" ? "active" : "")" href="@Url.Action("Index", "RentalRequest", new { area = "Admin" })" aria-current="@(controllerName == "RentalRequest" ? "page" : null)">
                            <span>Yêu cầu thuê</span>
                            @if (hasPending)
                            {
                                <span class="nav-count" title="Yêu cầu chờ duyệt">@pendingCount</span>
                            }
                        </a>

                        <div class="nav-label">Tài khoản</div>
                        <a class="nav-link @(isPassword ? "active" : "")" href="@Url.Action("ChangePassword", "Account", new { area = "Admin" })" aria-current="@(isPassword ? "page" : null)">Đổi mật khẩu</a>
                    </nav>
                    <div class="sidebar-footer mt-auto">
                        <a href="@Url.Action("Index", "Home", new { area = "" })" target="_blank" rel="noopener">Xem website (tab mới)</a>
                    </div>
                </div>
            </div>
        </aside>

        <div class="admin-main">
            <!-- ===== THANH TRÊN ===== -->
            <header class="admin-topbar">
                <button class="btn btn-outline-secondary btn-sm d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar">Menu</button>
                <h1 class="admin-page-title">@ViewBag.Title</h1>
                <div class="admin-user">
                    <span class="user-name">@adminName</span>
                    @using (Html.BeginForm("Logout", "Account", new { area = "Admin" }, FormMethod.Post, new { id = "logoutForm" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Đăng xuất</button>
                    }
                </div>
            </header>

            <!-- ===== NỘI DUNG ===== -->
            <main class="admin-content" id="admin-main" tabindex="-1">
                @Html.Partial("_Alerts")
                @RenderBody()
            </main>

            <footer class="admin-footer">
                &copy; @DateTime.Now.Year RentHouse · Trang quản trị
            </footer>
        </div>
    </div>

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
    <script src="~/Scripts/admin.js"></script>
</body>
</html>
