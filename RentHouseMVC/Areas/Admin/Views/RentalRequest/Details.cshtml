@model RentHouseMVC.Models.RentalRequest
@{
    ViewBag.Title = "Yêu cầu #" + Model.RequestId;
    string currentUrl = Request.RawUrl;
}

<p class="mb-3"><a href="@Url.Action("Index")">&lsaquo; Danh sách yêu cầu</a></p>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card admin-card h-100">
            <div class="card-header">
                <span>Thông tin khách hàng</span>
                @Html.Partial("_RequestStatus", Model.Status)
            </div>
            <div class="card-body">
                <dl class="detail-list">
                    <div><dt>Họ tên</dt><dd class="fw-semibold">@Model.CustomerName</dd></div>
                    <div><dt>Số điện thoại</dt><dd><a href="tel:@Model.CustomerPhone">@Model.CustomerPhone</a></dd></div>
                    <div>
                        <dt>Email</dt>
                        <dd>
                            @if (string.IsNullOrEmpty(Model.CustomerEmail))
                            {
                                <span class="text-muted">Không cung cấp</span>
                            }
                            else
                            {
                                <a href="mailto:@Model.CustomerEmail">@Model.CustomerEmail</a>
                            }
                        </dd>
                    </div>
                    <div><dt>Hẹn xem</dt><dd class="fw-semibold">@DisplayHelper.FormatDateTime(Model.ViewingDate)</dd></div>
                    <div><dt>Gửi lúc</dt><dd>@DisplayHelper.FormatDateTime(Model.CreatedDate) (@DisplayHelper.TimeAgo(Model.CreatedDate))</dd></div>
                    <div>
                        <dt>Lời nhắn</dt>
                        <dd>
                            @if (string.IsNullOrEmpty(Model.Note))
                            {
                                <span class="text-muted">Không có</span>
                            }
                            else
                            {
                                <span class="note-text">@Model.Note</span>
                            }
                        </dd>
                    </div>
                </dl>
            </div>
            <div class="card-footer">
                <div class="d-flex flex-wrap gap-2">
                    @if (Model.Status != RequestStatus.Approved)
                    {
                        using (Html.BeginForm("Approve", "RentalRequest", new { id = Model.RequestId }, FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@currentUrl" />
                            <button type="submit" class="btn btn-primary btn-sm">Duyệt yêu cầu</button>
                        }
                    }
                    @if (Model.Status != RequestStatus.Cancelled)
                    {
                        using (Html.BeginForm("Cancel", "RentalRequest", new { id = Model.RequestId }, FormMethod.Post, new { data_confirm = "Hủy yêu cầu này?" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@currentUrl" />
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Hủy yêu cầu</button>
                        }
                    }
                    @using (Html.BeginForm("Delete", "RentalRequest", new { id = Model.RequestId }, FormMethod.Post, new { data_confirm = "Xóa vĩnh viễn yêu cầu này?" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm">Xóa</button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card admin-card h-100">
            <div class="card-header"><span>Nhà khách muốn xem</span></div>
            <div class="card-body">
                <img src="@Url.HouseImage(Model.House.Image)" alt="@Model.House.Title" class="image-preview" />
                <h2 class="h6 mb-1">@Model.House.Title</h2>
                <p class="cell-sub mb-2 text-muted small">@Model.House.Address, @Model.House.District · @Model.House.Category.CatName</p>
                <p class="mb-3"><span class="price-cell">@DisplayHelper.FormatPrice(Model.House.Price)</span> &nbsp; @Html.Partial("_HouseStatus", Model.House.Status)</p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="@Url.Action("Details", "House", new { id = Model.HouseId, area = "" })" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">Xem trên website</a>
                    @using (Html.BeginForm("ToggleStatus", "House", new { id = Model.HouseId }, FormMethod.Post, new { data_confirm = "Đổi trạng thái nhà này?" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">
                            Chuyển sang "@(Model.House.Status == HouseStatus.Available ? HouseStatus.Rented : HouseStatus.Available)"
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
