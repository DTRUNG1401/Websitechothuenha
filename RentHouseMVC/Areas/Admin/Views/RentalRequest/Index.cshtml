@model RentHouseMVC.Models.ViewModels.AdminRequestListViewModel
@{
    ViewBag.Title = "Yêu cầu thuê";
    string currentUrl = Request.RawUrl;
}

<!-- Lọc theo trạng thái -->
<nav aria-label="Lọc theo trạng thái">
    <ul class="status-tabs">
        <li>
            <a href="@Url.Action("Index", new { status = "" })" class="@(Model.Status == null ? "active" : "")" aria-current="@(Model.Status == null ? "page" : null)">
                Tất cả <span class="count">@Model.TotalCount</span>
            </a>
        </li>
        @foreach (var s in RequestStatus.All)
        {
            <li>
                <a href="@Url.Action("Index", new { status = s })" class="@(Model.Status == s ? "active" : "")" aria-current="@(Model.Status == s ? "page" : null)">
                    @s <span class="count">@Model.CountOf(s)</span>
                </a>
            </li>
        }
    </ul>
</nav>

<div class="card admin-card">
    <div class="card-header">
        <span>@(Model.Status == null ? "Tất cả yêu cầu" : "Yêu cầu " + Model.Status.ToLower()) <span class="header-note">(@Model.Requests.TotalItemCount)</span></span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-admin">
            <thead>
                <tr>
                    <th scope="col">Mã</th>
                    <th scope="col">Khách hàng</th>
                    <th scope="col">Điện thoại</th>
                    <th scope="col">Nhà</th>
                    <th scope="col">Hẹn xem</th>
                    <th scope="col">Gửi lúc</th>
                    <th scope="col">Trạng thái</th>
                    <th scope="col" class="actions">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Requests.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Không có yêu cầu nào.</td></tr>
                }
                @foreach (var r in Model.Requests)
                {
                    <tr>
                        <td><a href="@Url.Action("Details", new { id = r.RequestId })" class="fw-semibold">#@r.RequestId</a></td>
                        <td class="cell-title text-nowrap">@r.CustomerName</td>
                        <td class="text-nowrap">@r.CustomerPhone</td>
                        <td class="cell-truncate">
                            <a href="@Url.Action("Details", "House", new { id = r.HouseId, area = "" })" target="_blank" rel="noopener" title="@r.House.Title">@r.House.Title</a>
                        </td>
                        <td class="text-nowrap">@DisplayHelper.FormatDateTime(r.ViewingDate)</td>
                        <td class="text-nowrap cell-sub">@DisplayHelper.FormatDateTime(r.CreatedDate)</td>
                        <td>@Html.Partial("_RequestStatus", r.Status)</td>
                        <td class="actions">
                            @if (r.Status != RequestStatus.Approved)
                            {
                                using (Html.BeginForm("Approve", "RentalRequest", new { id = r.RequestId }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                                    <button type="submit" class="btn btn-outline-primary btn-sm">Duyệt</button>
                                }
                            }
                            @if (r.Status != RequestStatus.Cancelled)
                            {
                                using (Html.BeginForm("Cancel", "RentalRequest", new { id = r.RequestId }, FormMethod.Post, new { data_confirm = "Hủy yêu cầu #" + r.RequestId + " của " + r.CustomerName + "?" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Hủy</button>
                                }
                            }
                            @using (Html.BeginForm("Delete", "RentalRequest", new { id = r.RequestId }, FormMethod.Post, new { data_confirm = "Xóa vĩnh viễn yêu cầu #" + r.RequestId + "?" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@currentUrl" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Xóa</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Requests.PageCount > 1)
    {
        <div class="card-footer pb-3">
            @Html.Partial("_Pager", new PagerModel(Model.Requests.PageNumber, Model.Requests.PageCount,
                p => Url.Action("Index", new { status = Model.Status, page = p })))
        </div>
    }
</div>
