@model RentHouseMVC.Models.Category
@{
    ViewBag.Title = "Thêm loại nhà";
}

<div class="card admin-card" style="max-width: 560px;">
    <div class="card-body p-4">
        @using (Html.BeginForm("Create", "Category", FormMethod.Post, new { novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "")

            <div class="mb-3">
                @Html.LabelFor(m => m.CatName, new { @class = "form-label" })<span class="required-mark" aria-hidden="true">*</span>
                @Html.TextBoxFor(m => m.CatName, new { @class = "form-control", placeholder = "VD: Mặt bằng kinh doanh", maxlength = "100", autofocus = "autofocus" })
                @Html.ValidationMessageFor(m => m.CatName)
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Lưu</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Hủy</a>
            </div>
        }
    </div>
</div>

@section scripts {
    @Html.Partial("_ValidationScriptsPartial")
}
