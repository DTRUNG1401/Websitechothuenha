@model RentHouseMVC.Models.ViewModels.CategoryDeleteViewModel
@{
    ViewBag.Title = "Xóa loại nhà";
}

<div class="card admin-card" style="max-width: 640px;">
    <div class="card-body p-4">
        <dl class="detail-list mb-4">
            <div><dt>Mã loại</dt><dd>@Model.Category.Id</dd></div>
            <div><dt>Tên loại nhà</dt><dd class="fw-semibold">@Model.Category.CatName</dd></div>
            <div><dt>Số nhà thuộc loại</dt><dd>@Model.HouseCount</dd></div>
        </dl>

        @if (Model.CanDelete)
        {
            <p>Xóa loại nhà này? Thao tác không thể hoàn tác.</p>
            using (Html.BeginForm("Delete", "Category", new { id = Model.Category.Id }, FormMethod.Post, null))
            {
                @Html.AntiForgeryToken()
                <div class="form-actions">
                    <button type="submit" class="btn btn-danger">Xóa loại nhà</button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Hủy</a>
                </div>
            }
        }
        else
        {
            <div class="alert alert-danger" role="alert">
                Không xóa được: loại "@Model.Category.CatName" đang có @Model.HouseCount nhà.
                Hãy chuyển các nhà này sang loại khác hoặc xóa chúng trước.
            </div>
            <div class="form-actions">
                <a href="@Url.Action("Index", "House", new { catId = Model.Category.Id })" class="btn btn-primary">Xem các nhà thuộc loại này</a>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Quay lại</a>
            </div>
        }
    </div>
</div>
