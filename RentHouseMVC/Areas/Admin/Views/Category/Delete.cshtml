@model RentHouseMVC.Models.ViewModels.CategoryDeleteViewModel
@{
    ViewBag.Title = "Xóa loại nhà";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card admin-card border-danger-subtle">
            <div class="card-header text-danger"><i class="bi bi-trash me-1"></i> Xóa loại nhà</div>
            <div class="card-body">
                <dl class="row mb-4">
                    <dt class="col-sm-4">Mã loại</dt>
                    <dd class="col-sm-8">@Model.Category.Id</dd>
                    <dt class="col-sm-4">Tên loại nhà</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.Category.CatName</dd>
                    <dt class="col-sm-4">Số nhà thuộc loại</dt>
                    <dd class="col-sm-8">@Model.HouseCount</dd>
                </dl>

                @if (Model.CanDelete)
                {
                    <div class="alert alert-warning small">
                        <i class="bi bi-exclamation-triangle me-1"></i> Bạn có chắc chắn muốn xóa loại nhà này? Thao tác không thể hoàn tác.
                    </div>
                    using (Html.BeginForm("Delete", "Category", new { id = Model.Category.Id }, FormMethod.Post, null))
                    {
                        @Html.AntiForgeryToken()
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Xác nhận xóa</button>
                            <a href="@Url.Action("Index")" class="btn btn-light">Quay lại</a>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-x-octagon me-1"></i>
                        <strong>Không thể xóa!</strong> Loại nhà "@Model.Category.CatName" đang có @Model.HouseCount nhà.
                        Hãy chuyển các nhà này sang loại khác hoặc xóa chúng trước khi xóa loại nhà.
                    </div>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Index", "House", new { catId = Model.Category.Id })" class="btn btn-primary"><i class="bi bi-houses me-1"></i>Xem các nhà thuộc loại này</a>
                        <a href="@Url.Action("Index")" class="btn btn-light">Quay lại</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
