@model List<RentHouseMVC.Models.ViewModels.CategorySummary>
@{
    ViewBag.Title = "Loại nhà";
}

<div class="card admin-card">
    <div class="card-header">
        <span>Loại nhà <span class="header-note">(@Model.Count)</span></span>
        <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">Thêm loại nhà</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-admin">
            <thead>
                <tr>
                    <th scope="col" style="width: 72px;">Mã</th>
                    <th scope="col">Tên loại nhà</th>
                    <th scope="col" class="num">Số nhà</th>
                    <th scope="col" class="num">Còn trống</th>
                    <th scope="col" class="actions">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Chưa có loại nhà nào.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td class="cell-title">@item.CatName</td>
                        <td class="num"><a href="@Url.Action("Index", "House", new { catId = item.Id })">@item.HouseCount</a></td>
                        <td class="num">@item.AvailableCount</td>
                        <td class="actions">
                            <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-outline-secondary btn-sm">Sửa</a>
                            <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-outline-danger btn-sm">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer small text-muted">
        Chỉ xóa được loại nhà khi không còn nhà nào thuộc loại đó.
    </div>
</div>
