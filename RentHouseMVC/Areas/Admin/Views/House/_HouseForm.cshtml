@model RentHouseMVC.Models.ViewModels.HouseFormViewModel
@*
    Form dùng chung cho Thêm / Sửa nhà (gọi từ Create.cshtml và Edit.cshtml,
    bên trong Html.BeginForm có enctype multipart/form-data).
    Máy tính: 2 cột – thông tin bên trái, ảnh bên phải. Thông báo lỗi nằm ngay dưới ô nhập.
*@
@Html.AntiForgeryToken()
@Html.HiddenFor(m => m.HouseId)
@Html.ValidationSummary(true, "")

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card admin-card">
            <div class="card-body p-4">
                <h2 class="form-section-title">Thông tin nhà</h2>
                <div class="row g-3">
                    <div class="col-12">
                        @Html.LabelFor(m => m.Title, new { @class = "form-label" })<span class="required-mark" aria-hidden="true">*</span>
                        @Html.TextBoxFor(m => m.Title, new { @class = "form-control", maxlength = "200", placeholder = "VD: Căn hộ mini có ban công, gần sân bay" })
                        @Html.ValidationMessageFor(m => m.Title)
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.CatId, new { @class = "form-label" })<span class="required-mark" aria-hidden="true">*</span>
                        @Html.DropDownListFor(m => m.CatId, (SelectList)ViewBag.Categories, "Chọn loại nhà", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.CatId)
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.District, new { @class = "form-label" })<span class="required-mark" aria-hidden="true">*</span>
                        @Html.DropDownListFor(m => m.District, (SelectList)ViewBag.Districts, "Chọn quận, huyện", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.District)
                    </div>

                    <div class="col-12">
                        @Html.LabelFor(m => m.Address, new { @class = "form-label" })<span class="required-mark" aria-hidden="true">*</span>
                        @Html.TextBoxFor(m => m.Address, new { @class = "form-control", maxlength = "255", placeholder = "VD: 35/2 Nguyễn Trọng Tuyển, Phường 15" })
                        @Html.ValidationMessageFor(m => m.Address)
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Price, new { @class = "form-label" })<span class="required-mark" aria-hidden="true">*</span>
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.Price, "{0:0}", new { @class = "form-control", type = "number", placeholder = "6500000", aria_describedby = "pricePreview" })
                            <span class="input-group-text">đ</span>
                        </div>
                        <div class="form-text" id="pricePreview"></div>
                        @Html.ValidationMessageFor(m => m.Price)
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Acreage, new { @class = "form-label" })<span class="required-mark" aria-hidden="true">*</span>
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.Acreage, new { @class = "form-control", type = "number", step = "any", placeholder = "35" })
                            <span class="input-group-text">m²</span>
                        </div>
                        @Html.ValidationMessageFor(m => m.Acreage)
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Bedrooms, new { @class = "form-label" })<span class="required-mark" aria-hidden="true">*</span>
                        @Html.TextBoxFor(m => m.Bedrooms, new { @class = "form-control", type = "number", placeholder = "1" })
                        @Html.ValidationMessageFor(m => m.Bedrooms)
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Status, new { @class = "form-label" })<span class="required-mark" aria-hidden="true">*</span>
                        @Html.DropDownListFor(m => m.Status, (SelectList)ViewBag.Statuses, new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.Status)
                    </div>

                    <div class="col-12">
                        @Html.LabelFor(m => m.Description, new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 8, placeholder = "Kết cấu, nội thất, tiện ích xung quanh, điều kiện thuê..." })
                        @Html.ValidationMessageFor(m => m.Description)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card admin-card">
            <div class="card-body p-4">
                <h2 class="form-section-title">Ảnh đại diện</h2>
                <img src="@Url.HouseImage(Model.CurrentImage)" alt="Ảnh hiện tại của nhà" id="imagePreview" class="image-preview" />
                <label for="ImageFile" class="form-label">Chọn ảnh mới</label>
                <input type="file" id="ImageFile" name="ImageFile" class="form-control"
                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                       data-max-size="@ImageHelper.MaxFileSize" data-preview="#imagePreview" aria-describedby="imageHelp" />
                <div class="form-text" id="imageHelp">JPG, PNG hoặc WEBP, dưới 2MB. @(Model.IsEdit ? "Để trống nếu giữ ảnh cũ." : "Có thể thêm sau.")</div>
                <span class="field-validation-error" id="ImageFile-client-error" role="alert"></span>
                @Html.ValidationMessageFor(m => m.ImageFile)
            </div>
        </div>
    </div>
</div>

<div class="form-actions">
    <button type="submit" class="btn btn-primary">@(Model.IsEdit ? "Lưu thay đổi" : "Đăng nhà")</button>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Hủy</a>
</div>
