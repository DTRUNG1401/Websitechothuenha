@model RentHouseMVC.Models.ViewModels.HouseFormViewModel
@{
    ViewBag.Title = "Sửa thông tin nhà #" + Model.HouseId;
}

@using (Html.BeginForm("Edit", "House", new { id = Model.HouseId }, FormMethod.Post, new { enctype = "multipart/form-data", novalidate = "novalidate" }))
{
    @Html.Partial("_HouseForm", Model)
}

@section scripts {
    @Html.Partial("_ValidationScriptsPartial")
}
