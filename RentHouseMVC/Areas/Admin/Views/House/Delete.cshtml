@model RentHouseMVC.Models.House
@{
    ViewBag.Title = "Xóa nhà";
    int requestCount = (int)ViewBag.RequestCount;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card admin-card border-danger-subtle">
            <div class="card-header text-danger"><i class="bi bi-trash me-1"></i> Xác nhận xóa nhà</div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-md-5">
                        <img src="@Url.HouseImage(Model.Image)" alt="@Model.Title" class="img-fluid rounded border" />
                    </div>
                    <div class="col-md-7">
                        <h2 class="h5 fw-bold">@Model.Title</h2>
                        <dl class="row small mb-0">
                            <dt class="col-sm-4">Loại nhà</dt>
                            <dd class="col-sm-8">@Model.Category.CatName</dd>
                            <dt class="col-sm-4">Địa chỉ</dt>
                            <dd class="col-sm-8">@Model.Address, @Model.District</dd>
                            <dt class="col-sm-4">Giá thuê</dt>
                            <dd class="col-sm-8">@DisplayHelper.FormatPrice(Model.Price)</dd>
                            <dt class="col-sm-4">Trạng thái</dt>
                            <dd class="col-sm-8"><span class="badge @DisplayHelper.HouseStatusCss(Model.Status)">@Model.Status</span></dd>
                            <dt class="col-sm-4">Ngày đăng</dt>
                            <dd class="col-sm-8">@DisplayHelper.FormatDateTime(Model.PostedDate)</dd>
                        </dl>
                    </div>
                </div>

                <div class="alert alert-warning small mt-4 mb-4">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Thao tác không thể hoàn tác.
                    @if (requestCount > 0)
                    {
                        <strong>Nhà này có @requestCount yêu cầu thuê, các yêu cầu đó cũng sẽ bị xóa theo.</strong>
                    }
                </div>

                @using (Html.BeginForm("Delete", "House", new { id = Model.HouseId }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Xác nhận xóa</button>
                        <a href="@Url.Action("Index")" class="btn btn-light">Quay lại</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
