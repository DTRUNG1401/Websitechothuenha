@model RentHouseMVC.Models.House
@{
    ViewBag.Title = "Xóa nhà";
    int requestCount = (int)ViewBag.RequestCount;
}

<div class="card admin-card" style="max-width: 820px;">
    <div class="card-body p-4">
        <div class="row g-4">
            <div class="col-md-4">
                <img src="@Url.HouseImage(Model.Image)" alt="@Model.Title" class="image-preview mb-0" />
            </div>
            <div class="col-md-8">
                <h2 class="h5">@Model.Title</h2>
                <dl class="detail-list">
                    <div><dt>Loại nhà</dt><dd>@Model.Category.CatName</dd></div>
                    <div><dt>Địa chỉ</dt><dd>@Model.Address, @Model.District</dd></div>
                    <div><dt>Giá thuê</dt><dd>@DisplayHelper.FormatPrice(Model.Price)</dd></div>
                    <div><dt>Trạng thái</dt><dd>@Html.Partial("_HouseStatus", Model.Status)</dd></div>
                    <div><dt>Ngày đăng</dt><dd>@DisplayHelper.FormatDateTime(Model.PostedDate)</dd></div>
                </dl>
            </div>
        </div>

        <div class="alert alert-warning mt-4">
            Xóa nhà này? Thao tác không thể hoàn tác.
            @if (requestCount > 0)
            {
                <strong>@requestCount yêu cầu thuê của nhà này cũng sẽ bị xóa.</strong>
            }
        </div>

        @using (Html.BeginForm("Delete", "House", new { id = Model.HouseId }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="form-actions mt-0">
                <button type="submit" class="btn btn-danger">Xóa nhà</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Hủy</a>
            </div>
        }
    </div>
</div>
