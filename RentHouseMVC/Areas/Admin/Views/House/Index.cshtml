@model RentHouseMVC.Models.ViewModels.AdminHouseListViewModel
@{
    ViewBag.Title = "Nhà cho thuê";
    string currentUrl = Request.RawUrl;
}

<div class="card admin-card">
    <div class="card-header">
        <span>Danh sách nhà <span class="header-note">(@Model.Houses.TotalItemCount)</span></span>
        <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">Đăng nhà mới</a>
    </div>

    <!-- Bộ lọc -->
    <form action="@Url.Action("Index")" method="get" class="admin-filter">
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <label for="keyword" class="form-label">Từ khóa</label>
                <input type="search" id="keyword" name="keyword" value="@Model.Keyword" class="form-control form-control-sm" placeholder="Tiêu đề, địa chỉ, quận" maxlength="100" />
            </div>
            <div class="col-6 col-md-3">
                <label for="catId" class="form-label">Loại nhà</label>
                @Html.DropDownList("catId", Model.Categories, "Tất cả", new { @class = "form-select form-select-sm", id = "catId" })
            </div>
            <div class="col-6 col-md-2">
                <label for="status" class="form-label">Trạng thái</label>
                <select id="status" name="status" class="form-select form-select-sm">
                    <option value="">Tất cả</option>
                    @foreach (var s in HouseStatus.All)
                    {
                        <option value="@s" selected="@(Model.Status == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Lọc</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">Xóa lọc</a>
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover table-admin">
            <thead>
                <tr>
                    <th scope="col" style="width: 80px;">Ảnh</th>
                    <th scope="col">Nhà</th>
                    <th scope="col">Loại</th>
                    <th scope="col" class="num">Giá/tháng</th>
                    <th scope="col">Trạng thái</th>
                    <th scope="col" class="actions">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Houses.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Không có nhà nào phù hợp.</td></tr>
                }
                @foreach (var h in Model.Houses)
                {
                    <tr>
                        <td><img src="@Url.HouseImage(h.Image)" alt="@h.Title" class="admin-thumb" /></td>
                        <td class="cell-truncate">
                            <div class="cell-title" title="@h.Title">@h.Title</div>
                            <div class="cell-sub">@h.Address, @h.District · đăng @DisplayHelper.FormatDate(h.PostedDate)</div>
                        </td>
                        <td class="text-nowrap">@h.Category.CatName</td>
                        <td class="num price-cell">@DisplayHelper.FormatMoney(h.Price)</td>
                        <td>
                            @using (Html.BeginForm("ToggleStatus", "House", new { id = h.HouseId }, FormMethod.Post, new { data_confirm = "Đổi trạng thái của nhà \"" + h.Title + "\"?" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@currentUrl" />
                                <button type="submit" class="status-toggle" title="Đổi trạng thái Còn trống / Đã thuê">
                                    @Html.Partial("_HouseStatus", h.Status)
                                    <span class="toggle-hint">Đổi</span>
                                </button>
                            }
                        </td>
                        <td class="actions">
                            <a href="@Url.Action("Details", "House", new { id = h.HouseId, area = "" })" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">Xem</a>
                            <a href="@Url.Action("Edit", new { id = h.HouseId })" class="btn btn-outline-secondary btn-sm">Sửa</a>
                            <a href="@Url.Action("Delete", new { id = h.HouseId })" class="btn btn-outline-danger btn-sm">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Houses.PageCount > 1)
    {
        <div class="card-footer pb-3">
            @Html.Partial("_Pager", new PagerModel(Model.Houses.PageNumber, Model.Houses.PageCount,
                p => Url.Action("Index", new { keyword = Model.Keyword, catId = Model.CatId, status = Model.Status, page = p })))
        </div>
    }
</div>
