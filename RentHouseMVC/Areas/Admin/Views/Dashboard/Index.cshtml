@model RentHouseMVC.Models.ViewModels.DashboardViewModel
@{
    ViewBag.Title = "Tổng quan";
}

<div class="toolbar">
    <h2>Số liệu ngày @DateTime.Now.ToString("dd/MM/yyyy")</h2>
    <a href="@Url.Action("Create", "House")" class="btn btn-primary btn-sm">Đăng nhà mới</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="stat-box">
            <div class="stat-label">Tổng số nhà</div>
            <div class="stat-value">@Model.TotalHouses</div>
            <div class="stat-note">Thuộc @Model.TotalCategories loại nhà</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-box">
            <div class="stat-label">Nhà còn trống</div>
            <div class="stat-value">@Model.AvailableHouses</div>
            <div class="stat-note">@Model.RentedHouses nhà đã cho thuê</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-box">
            <div class="stat-label">Yêu cầu chờ duyệt</div>
            <div class="stat-value">@Model.PendingRequests</div>
            <div class="stat-note"><a href="@Url.Action("Index", "RentalRequest", new { status = RequestStatus.Pending })">Xem danh sách</a></div>
        </div>
    </div>
</div>

<div class="card admin-card">
    <div class="card-header">
        <span>Yêu cầu mới nhất <span class="header-note">(tổng @Model.TotalRequests yêu cầu)</span></span>
        <a href="@Url.Action("Index", "RentalRequest")" class="btn btn-outline-secondary btn-sm">Xem tất cả</a>
    </div>
    @if (Model.LatestRequests.Count == 0)
    {
        <div class="card-body text-muted">Chưa có yêu cầu nào.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-admin">
                <thead>
                    <tr>
                        <th scope="col">Mã</th>
                        <th scope="col">Khách hàng</th>
                        <th scope="col">Điện thoại</th>
                        <th scope="col">Nhà</th>
                        <th scope="col">Hẹn xem</th>
                        <th scope="col">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.LatestRequests)
                    {
                        <tr>
                            <td><a href="@Url.Action("Details", "RentalRequest", new { id = r.RequestId })">#@r.RequestId</a></td>
                            <td class="cell-title text-nowrap">@r.CustomerName</td>
                            <td class="text-nowrap">@r.CustomerPhone</td>
                            <td class="text-truncate" style="max-width: 260px;" title="@r.House.Title">@r.House.Title</td>
                            <td class="text-nowrap">@DisplayHelper.FormatDateTime(r.ViewingDate)</td>
                            <td>@Html.Partial("_RequestStatus", r.Status)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
