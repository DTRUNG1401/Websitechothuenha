@{
    ViewBag.Title = "Không tìm thấy trang";
}

<div class="container error-page">
    <p class="error-code">Lỗi 404</p>
    <h1>Không tìm thấy trang</h1>
    <p class="text-muted">
        Đường dẫn có thể đã bị gõ sai, hoặc tin cho thuê này đã được gỡ.
    </p>
    <div class="error-actions">
        <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-primary">Về trang chủ</a>
        <a href="@Url.Action("Search", "House", new { area = "" })" class="btn btn-outline-secondary">Tìm nhà khác</a>
    </div>
</div>
