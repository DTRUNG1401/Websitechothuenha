@{
    ViewBag.Title = "Không tìm thấy trang";
}

<div class="container error-page">
    <div class="error-code">4<span><i class="bi bi-house-x"></i></span>4</div>
    <h1>Ôi! Không tìm thấy trang bạn cần</h1>
    <p class="text-muted">
        Trang bạn truy cập không tồn tại, đã bị xóa hoặc đường dẫn bị gõ sai.<br />
        Có thể căn nhà này đã được gỡ khỏi hệ thống.
    </p>
    <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
        <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-primary btn-lg"><i class="bi bi-house me-1"></i>Về trang chủ</a>
        <a href="@Url.Action("Search", "House", new { area = "" })" class="btn btn-outline-primary btn-lg"><i class="bi bi-search me-1"></i>Tìm nhà khác</a>
    </div>
</div>
