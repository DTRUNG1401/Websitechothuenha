@model RentHouseMVC.Models.ViewModels.ErrorViewModel
@{
    ViewBag.Title = Model.Title;
}

<div class="container error-page">
    <p class="error-code">Lỗi @Model.StatusCode</p>
    <h1>@Model.Title</h1>
    <p class="text-muted">@Model.Message</p>
    <div class="error-actions">
        <a href="javascript:history.back()" class="btn btn-outline-secondary">Quay lại</a>
        <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-primary">Về trang chủ</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.Detail))
    {
        <div class="alert alert-secondary error-detail">
            <strong>Chi tiết kỹ thuật</strong> (chỉ hiện khi chạy trên máy cá nhân)
            <pre>@Model.Detail</pre>
        </div>
    }
</div>
