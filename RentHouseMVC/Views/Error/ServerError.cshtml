@model RentHouseMVC.Models.ViewModels.ErrorViewModel
@{
    ViewBag.Title = Model.Title;
}

<div class="container error-page">
    <div class="error-code error-code-danger">@Model.StatusCode</div>
    <h1>@Model.Title</h1>
    <p class="text-muted">@Model.Message</p>
    <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
        <a href="javascript:history.back()" class="btn btn-outline-primary btn-lg"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
        <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-primary btn-lg"><i class="bi bi-house me-1"></i>Về trang chủ</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.Detail))
    {
        <div class="alert alert-warning text-start mt-5 mx-auto error-detail">
            <div class="fw-semibold mb-1"><i class="bi bi-bug me-1"></i>Chi tiết kỹ thuật (chỉ hiển thị khi chạy trên localhost)</div>
            <pre class="mb-0 small">@Model.Detail</pre>
        </div>
    }
</div>
