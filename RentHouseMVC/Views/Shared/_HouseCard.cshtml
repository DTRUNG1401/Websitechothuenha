@model RentHouseMVC.Models.House
@*
    Thẻ nhà: ảnh 4:3, giá đặt trước, tiêu đề tối đa 2 dòng, một dòng thông số.
    Nhãn "Đã thuê" chỉ hiện khi nhà đã có người thuê. Cả thẻ bấm được (stretched-link).
*@
@{
    bool rented = Model.Status != HouseStatus.Available;
}
<article class="listing-card">
    <div class="listing-media">
        <img src="@Url.HouseImage(Model.Image)" alt="@Model.Title" loading="lazy" />
        @if (rented)
        {
            <span class="listing-flag">@Model.Status</span>
        }
    </div>
    <div class="listing-body">
        <p class="listing-price">@DisplayHelper.FormatMoney(Model.Price)<span>/tháng</span></p>
        <h3 class="listing-title">
            <a href="@Url.Action("Details", "House", new { id = Model.HouseId, area = "" })" class="stretched-link">@Model.Title</a>
        </h3>
        <p class="listing-meta">@DisplayHelper.FormatAcreage(Model.Acreage) · @Model.Bedrooms PN · @Model.District</p>
    </div>
</article>
