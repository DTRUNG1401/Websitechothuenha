@model List<RentHouseMVC.Models.ViewModels.CategorySummary>
@{
    string controllerName = (ViewContext.ParentActionViewContext.RouteData.Values["controller"] as string) ?? string.Empty;
    string actionName = (ViewContext.ParentActionViewContext.RouteData.Values["action"] as string) ?? string.Empty;
    bool isHouseList = controllerName == "House" && (actionName == "Index" || actionName == "Details");
}
<li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle @(isHouseList ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        Nhà cho thuê
    </a>
    <ul class="dropdown-menu shadow border-0 py-2">
        <li>
            <a class="dropdown-item" href="@Url.Action("Index", "House", new { id = "", area = "" })">
                <i class="bi bi-grid me-2"></i>Tất cả nhà
            </a>
        </li>
        @if (Model.Count > 0)
        {
            <li><hr class="dropdown-divider" /></li>
        }
        @foreach (var item in Model)
        {
            <li>
                <a class="dropdown-item d-flex justify-content-between align-items-center gap-4"
                   href="@Url.Action("Index", "House", new { id = item.Id, area = "" })">
                    <span><i class="bi @DisplayHelper.CategoryIcon(item.CatName) me-2"></i>@item.CatName</span>
                    <span class="badge rounded-pill text-bg-light">@item.HouseCount</span>
                </a>
            </li>
        }
    </ul>
</li>
