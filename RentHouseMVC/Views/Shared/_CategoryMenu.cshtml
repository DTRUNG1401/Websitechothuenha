@model List<RentHouseMVC.Models.ViewModels.CategorySummary>
@{
    string controllerName = (ViewContext.ParentActionViewContext.RouteData.Values["controller"] as string) ?? string.Empty;
    string actionName = (ViewContext.ParentActionViewContext.RouteData.Values["action"] as string) ?? string.Empty;
    bool isHouseList = controllerName == "House" && (actionName == "Index" || actionName == "Details");
}
<li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle @(isHouseList ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        Nhà cho thuê
    </a>
    <ul class="dropdown-menu">
        <li><a class="dropdown-item" href="@Url.Action("Index", "House", new { id = "", area = "" })">Tất cả nhà</a></li>
        @foreach (var item in Model)
        {
            <li>
                <a class="dropdown-item d-flex justify-content-between gap-4" href="@Url.Action("Index", "House", new { id = item.Id, area = "" })">
                    <span>@item.CatName</span>
                    <span class="text-muted">@item.HouseCount</span>
                </a>
            </li>
        }
    </ul>
</li>
