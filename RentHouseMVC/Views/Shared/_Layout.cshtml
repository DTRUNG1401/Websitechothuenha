@{
    // Trang lỗi không gọi child action (tránh lỗi dây chuyền khi database gặp sự cố)
    bool isErrorPage = ViewBag.IsErrorPage is bool && (bool)ViewBag.IsErrorPage;
    string controllerName = (ViewContext.RouteData.Values["controller"] as string) ?? string.Empty;
    string actionName = (ViewContext.RouteData.Values["action"] as string) ?? string.Empty;
    bool isHome = controllerName == "Home" && actionName == "Index";
    bool isSearch = controllerName == "House" && actionName == "Search";
    bool isAbout = controllerName == "Home" && actionName == "About";
    bool isContact = controllerName == "Home" && actionName == "Contact";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="RentHouse – nhà nguyên căn, phòng trọ, căn hộ chung cư và căn hộ mini cho thuê tại TP.HCM." />
    <meta name="theme-color" content="#1F3B66" />
    <title>@ViewBag.Title | RentHouse</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" href="~/Content/images/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="~/Content/fonts/be-vietnam-pro-vietnamese-400-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/Content/theme.css" rel="stylesheet" />
    <link href="~/Content/site.css" rel="stylesheet" />
    @RenderSection("styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main">Bỏ qua đến nội dung chính</a>

    <header class="site-header">
        <nav class="navbar navbar-expand-lg" aria-label="Menu chính">
            <div class="container">
                <a class="navbar-brand brand" href="@Url.Action("Index", "Home", new { area = "" })">RentHouse</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav site-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link @(isHome ? "active" : "")" href="@Url.Action("Index", "Home", new { area = "" })" aria-current="@(isHome ? "page" : null)">Trang chủ</a>
                        </li>
                        @if (isErrorPage)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index", "House", new { id = "", area = "" })">Nhà cho thuê</a>
                            </li>
                        }
                        else
                        {
                            @Html.Action("CategoryMenu", "Home", new { area = "" })
                        }
                        <li class="nav-item">
                            <a class="nav-link @(isSearch ? "active" : "")" href="@Url.Action("Search", "House", new { area = "" })" aria-current="@(isSearch ? "page" : null)">Tìm kiếm</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isAbout ? "active" : "")" href="@Url.Action("About", "Home", new { area = "" })" aria-current="@(isAbout ? "page" : null)">Giới thiệu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isContact ? "active" : "")" href="@Url.Action("Contact", "Home", new { area = "" })" aria-current="@(isContact ? "page" : null)">Liên hệ</a>
                        </li>
                    </ul>
                    <a class="header-admin-link" href="@Url.Action("Login", "Account", new { area = "Admin" })">Đăng nhập quản trị</a>
                </div>
            </div>
        </nav>
    </header>

    <main id="main" class="site-main" tabindex="-1">
        @if (TempData["Success"] != null || TempData["Error"] != null)
        {
            <div class="container pt-3">
                @Html.Partial("_Alerts")
            </div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-4">
                    <a class="brand" href="@Url.Action("Index", "Home", new { area = "" })">RentHouse</a>
                    <p class="mt-2 mb-0">
                        Tin cho thuê nhà nguyên căn, phòng trọ, căn hộ chung cư và căn hộ mini tại TP.HCM.
                        Khách đặt lịch xem nhà trực tuyến, không cần tạo tài khoản.
                    </p>
                </div>
                <div class="col-6 col-lg-2">
                    <h2 class="footer-title">Nhà cho thuê</h2>
                    <ul class="list-unstyled footer-links mb-0">
                        <li><a href="@Url.Action("Index", "House", new { id = "", area = "" })">Tất cả nhà</a></li>
                        <li><a href="@Url.Action("Search", "House", new { onlyAvailable = "true", area = "" })">Nhà còn trống</a></li>
                        <li><a href="@Url.Action("Search", "House", new { area = "" })">Tìm kiếm</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h2 class="footer-title">RentHouse</h2>
                    <ul class="list-unstyled footer-links mb-0">
                        <li><a href="@Url.Action("About", "Home", new { area = "" })">Giới thiệu</a></li>
                        <li><a href="@Url.Action("Contact", "Home", new { area = "" })">Liên hệ</a></li>
                        <li><a href="@Url.Action("Login", "Account", new { area = "Admin" })">Quản trị</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h2 class="footer-title">Liên hệ</h2>
                    <p class="mb-0">
                        273 An Dương Vương, Phường 3, Quận 5<br />
                        Điện thoại: 1900 6868<br />
                        Email: hotro@renthouse.vn
                    </p>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container py-3">
                &copy; @DateTime.Now.Year RentHouse · Đồ án môn Lập trình web (ASP.NET MVC 5). Dữ liệu nhà chỉ để minh họa.
            </div>
        </div>
    </footer>

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
    <script src="~/Scripts/site.js"></script>
</body>
</html>
