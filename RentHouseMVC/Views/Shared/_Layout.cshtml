@{
    // Trang lỗi không gọi child action (tránh lỗi dây chuyền khi database gặp sự cố)
    bool isErrorPage = ViewBag.IsErrorPage is bool && (bool)ViewBag.IsErrorPage;
    string controllerName = (ViewContext.RouteData.Values["controller"] as string) ?? string.Empty;
    string actionName = (ViewContext.RouteData.Values["action"] as string) ?? string.Empty;
    bool isHome = controllerName == "Home" && actionName == "Index";
    bool isSearch = controllerName == "House" && actionName == "Search";
    bool isAbout = controllerName == "Home" && actionName == "About";
    bool isContact = controllerName == "Home" && actionName == "Contact";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="RentHouse - Website cho thuê nhà nguyên căn, phòng trọ, căn hộ chung cư, căn hộ mini tại TP.HCM" />
    <title>@ViewBag.Title | RentHouse - Cho thuê nhà TP.HCM</title>
    <link rel="icon" href="~/Content/images/favicon.svg" type="image/svg+xml" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/Content/site.css" rel="stylesheet" />
    @RenderSection("styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- ===== THANH ĐIỀU HƯỚNG ===== -->
    <nav class="navbar navbar-expand-lg bg-white sticky-top site-navbar">
        <div class="container">
            <a class="navbar-brand brand" href="@Url.Action("Index", "Home", new { area = "" })">
                <span class="brand-logo"><i class="bi bi-house-heart-fill"></i></span>
                <span>Rent<span class="brand-accent">House</span></span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-2">
                    <li class="nav-item">
                        <a class="nav-link @(isHome ? "active" : "")" href="@Url.Action("Index", "Home", new { area = "" })">Trang chủ</a>
                    </li>
                    @if (isErrorPage)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "House", new { id = "", area = "" })">Nhà cho thuê</a>
                        </li>
                    }
                    else
                    {
                        @Html.Action("CategoryMenu", "Home", new { area = "" })
                    }
                    <li class="nav-item">
                        <a class="nav-link @(isSearch ? "active" : "")" href="@Url.Action("Search", "House", new { area = "" })">Tìm kiếm</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(isAbout ? "active" : "")" href="@Url.Action("About", "Home", new { area = "" })">Giới thiệu</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(isContact ? "active" : "")" href="@Url.Action("Contact", "Home", new { area = "" })">Liên hệ</a>
                    </li>
                </ul>
                <div class="d-flex gap-2">
                    <a class="btn btn-outline-primary btn-sm px-3" href="@Url.Action("Login", "Account", new { area = "Admin" })">
                        <i class="bi bi-person-lock me-1"></i>Quản trị
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- ===== NỘI DUNG TRANG ===== -->
    <main class="flex-grow-1">
        @if (TempData["Success"] != null || TempData["Error"] != null)
        {
            <div class="container pt-3">
                @Html.Partial("_Alerts")
            </div>
        }
        @RenderBody()
    </main>

    <!-- ===== CHÂN TRANG ===== -->
    <footer class="site-footer mt-5">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-4">
                    <a class="brand text-white text-decoration-none fs-4" href="@Url.Action("Index", "Home", new { area = "" })">
                        <span class="brand-logo"><i class="bi bi-house-heart-fill"></i></span>
                        <span>Rent<span class="brand-accent">House</span></span>
                    </a>
                    <p class="mt-3 mb-0 text-white-50">
                        Kênh thông tin cho thuê nhà nguyên căn, phòng trọ, căn hộ chung cư và căn hộ mini tại TP.HCM.
                        Đặt lịch xem nhà nhanh chóng, minh bạch, miễn phí.
                    </p>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="footer-title">Khám phá</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="@Url.Action("Index", "House", new { id = "", area = "" })">Tất cả nhà</a></li>
                        <li><a href="@Url.Action("Search", "House", new { area = "" })">Tìm kiếm nâng cao</a></li>
                        <li><a href="@Url.Action("Search", "House", new { onlyAvailable = "true", area = "" })">Nhà còn trống</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="footer-title">Về chúng tôi</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="@Url.Action("About", "Home", new { area = "" })">Giới thiệu</a></li>
                        <li><a href="@Url.Action("Contact", "Home", new { area = "" })">Liên hệ</a></li>
                        <li><a href="@Url.Action("Login", "Account", new { area = "Admin" })">Trang quản trị</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h6 class="footer-title">Liên hệ</h6>
                    <ul class="list-unstyled footer-contact text-white-50">
                        <li><i class="bi bi-geo-alt"></i>273 An Dương Vương, Phường 3, Quận 5, TP.HCM</li>
                        <li><i class="bi bi-telephone"></i>1900 6868 (8:00 - 21:00)</li>
                        <li><i class="bi bi-envelope"></i>hotro@renthouse.vn</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container py-3 d-flex flex-column flex-md-row justify-content-between gap-2 small">
                <span>&copy; @DateTime.Now.Year RentHouse. Đồ án môn Lập trình web - ASP.NET MVC 5.</span>
                <span>Dữ liệu nhà trên website chỉ mang tính minh họa.</span>
            </div>
        </div>
    </footer>

    <button type="button" class="btn btn-primary back-to-top shadow" id="backToTop" aria-label="Lên đầu trang">
        <i class="bi bi-arrow-up"></i>
    </button>

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
    <script src="~/Scripts/site.js"></script>
</body>
</html>
