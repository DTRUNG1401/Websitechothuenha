@model RentHouseMVC.Models.ViewModels.HomeViewModel
@{
    ViewBag.Title = "Nhà cho thuê tại TP.HCM";
}
@functions {
    // Ảnh đại diện cho từng loại nhà (dùng lại ảnh của một căn mẫu thuộc loại đó)
    private static string TypeImage(string catName)
    {
        string name = (catName ?? string.Empty).ToLowerInvariant();
        if (name.Contains("trọ")) return "~/Content/images/houses/mau-04.jpg";
        if (name.Contains("mini")) return "~/Content/images/houses/mau-10.jpg";
        if (name.Contains("chung cư")) return "~/Content/images/houses/mau-07.jpg";
        if (name.Contains("nguyên căn")) return "~/Content/images/houses/mau-01.jpg";
        return "~/Content/images/no-image.svg";
    }
}

<section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-media">
        <img src="~/Content/images/hero.jpg" alt="Nhà phố ở TP. Hồ Chí Minh" />
    </div>
    <div class="container home-search-wrap">
        <div class="home-search">
            <h1 id="home-title">Nhà cho thuê tại TP. Hồ Chí Minh</h1>
            <p class="home-search-lead">
                @Model.TotalHouses tin cho thuê ở @Model.TotalDistricts quận, huyện, trong đó @Model.AvailableHouses nhà còn trống.
            </p>
            <form action="@Url.Action("Search", "House")" method="get" class="search-bar" role="search" aria-label="Tìm nhà cho thuê">
                <div class="row g-2">
                    <div class="col-12 col-lg-4">
                        <label class="visually-hidden" for="hsKeyword">Từ khóa</label>
                        <div class="search-keyword">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <input type="search" id="hsKeyword" name="keyword" class="form-control" maxlength="100" placeholder="Tên đường, phường, dự án" />
                        </div>
                    </div>
                    <div class="col-6 col-lg-2">
                        <label class="visually-hidden" for="hsCatId">Loại nhà</label>
                        <select id="hsCatId" name="catId" class="form-select">
                            <option value="">Mọi loại nhà</option>
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.Id">@c.CatName</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-lg-2">
                        <label class="visually-hidden" for="hsDistrict">Quận, huyện</label>
                        <select id="hsDistrict" name="district" class="form-select">
                            <option value="">Mọi khu vực</option>
                            @foreach (var item in SearchOptions.DistrictItems(null))
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-lg-2">
                        <label class="visually-hidden" for="hsPrice">Mức giá</label>
                        <select id="hsPrice" name="price" class="form-select">
                            <option value="">Mọi mức giá</option>
                            @foreach (var item in SearchOptions.PriceRangeItems(null))
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-lg-2">
                        <button type="submit" class="btn btn-accent"><i class="bi bi-search" aria-hidden="true"></i>Tìm nhà</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

<section class="container section" aria-labelledby="types-title">
    <div class="section-head">
        <h2 id="types-title">Tìm theo loại nhà</h2>
        <a href="@Url.Action("Index", "House", new { id = "" })">Xem tất cả nhà</a>
    </div>
    <div class="row g-3 g-lg-4">
        @foreach (var c in Model.Categories)
        {
            <div class="col-6 col-lg-3">
                <div class="type-card">
                    <div class="type-card-media">
                        <img src="@Url.Content(TypeImage(c.CatName))" alt="Ảnh minh họa @c.CatName" loading="lazy" />
                    </div>
                    <div class="type-card-body">
                        <a class="type-card-name" href="@Url.Action("Index", "House", new { id = c.Id })">@c.CatName</a>
                        <span class="type-card-count">@c.HouseCount nhà · @c.AvailableCount còn trống</span>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<section class="container section" aria-labelledby="latest-title">
    <div class="section-head">
        <h2 id="latest-title">Nhà mới đăng</h2>
        <a href="@Url.Action("Search", "House", new { onlyAvailable = "true" })">Xem tất cả nhà còn trống</a>
    </div>
    @if (Model.LatestHouses.Count == 0)
    {
        <div class="empty-state">
            <h3 class="h5">Chưa có nhà còn trống</h3>
            <p class="mb-0">Các căn đang trống sẽ hiện ở đây.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var house in Model.LatestHouses)
            {
                <div class="col-sm-6 col-lg-4">
                    @Html.Partial("_HouseCard", house)
                </div>
            }
        </div>
    }
</section>
