@{
    ViewBag.Title = "Liên hệ";
}

<div class="page-head">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Liên hệ</li>
            </ol>
        </nav>
        <h1>Liên hệ</h1>
        <p class="page-head-lead">Gọi điện hoặc gửi email trong giờ làm việc. Muốn xem một căn cụ thể, hãy đặt lịch ngay trên trang của căn đó.</p>
    </div>
</div>

<div class="container section">
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="panel h-100">
                <h2>Văn phòng RentHouse</h2>
                <dl class="fact-list">
                    <div><dt>Địa chỉ</dt><dd>273 An Dương Vương, Phường 3, Quận 5</dd></div>
                    <div><dt>Điện thoại</dt><dd>1900 6868</dd></div>
                    <div><dt>Zalo</dt><dd>0901 234 567</dd></div>
                    <div><dt>Email</dt><dd>hotro@renthouse.vn</dd></div>
                    <div><dt>Giờ làm việc</dt><dd>8:00 – 21:00, cả tuần</dd></div>
                </dl>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="panel h-100">
                <h2>Đặt lịch xem nhà</h2>
                <ol class="steps">
                    <li>Tìm căn phù hợp ở trang <a href="@Url.Action("Search", "House")">Tìm kiếm</a>.</li>
                    <li>Mở trang chi tiết, điền họ tên, số điện thoại và giờ muốn xem.</li>
                    <li>Nhân viên gọi lại để xác nhận lịch hẹn, thường trong 2–4 giờ làm việc.</li>
                </ol>
                <a href="@Url.Action("Search", "House", new { onlyAvailable = "true" })" class="btn btn-primary">Xem nhà còn trống</a>
            </div>
        </div>
    </div>

    <h2 class="h5 mt-5 mb-3">Câu hỏi thường gặp</h2>
    <div class="accordion" id="faq">
        <div class="accordion-item">
            <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq1" aria-expanded="false" aria-controls="faq1">
                    Đặt lịch xem nhà có mất phí không?
                </button>
            </h3>
            <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#faq">
                <div class="accordion-body">Không. Bạn chỉ trả tiền cọc và tiền thuê khi ký hợp đồng với chủ nhà.</div>
            </div>
        </div>
        <div class="accordion-item">
            <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2" aria-expanded="false" aria-controls="faq2">
                    Bao lâu thì có người gọi lại?
                </button>
            </h3>
            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faq">
                <div class="accordion-body">Thường trong 2–4 giờ làm việc. Yêu cầu gửi sau 21:00 sẽ được gọi lại vào sáng hôm sau.</div>
            </div>
        </div>
        <div class="accordion-item">
            <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3" aria-expanded="false" aria-controls="faq3">
                    Tôi muốn đăng tin cho thuê nhà của mình?
                </button>
            </h3>
            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faq">
                <div class="accordion-body">Gọi 1900 6868 hoặc gửi email kèm địa chỉ, giá thuê và vài tấm ảnh. Quản trị viên kiểm tra rồi đăng tin giúp bạn.</div>
            </div>
        </div>
    </div>
</div>
