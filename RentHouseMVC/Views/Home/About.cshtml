@{
    ViewBag.Title = "Giới thiệu";
}

<div class="page-head">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Giới thiệu</li>
            </ol>
        </nav>
        <h1>Giới thiệu RentHouse</h1>
    </div>
</div>

<div class="container section">
    <div class="row g-4 g-lg-5">
        <div class="col-lg-7">
            <div class="prose">
                <p>
                    RentHouse là website đăng tin cho thuê nhà tại TP. Hồ Chí Minh, làm trong khuôn khổ đồ án môn
                    Lập trình web. Website dùng ASP.NET MVC 5, Entity Framework 6 và SQL Server.
                </p>
                <p>
                    Người thuê xem nhà theo từng loại, lọc theo quận, mức giá, diện tích và số phòng ngủ, rồi gửi yêu cầu
                    xem nhà ngay trên trang chi tiết. Không cần tạo tài khoản.
                </p>
                <p>
                    Quản trị viên nhận yêu cầu, gọi lại cho khách để chốt giờ hẹn và cập nhật tình trạng
                    Còn trống / Đã thuê của từng căn.
                </p>

                <h2 class="h5 mt-4">Mỗi tin cho thuê gồm</h2>
                <ul>
                    <li>Giá thuê theo tháng, diện tích, số phòng ngủ</li>
                    <li>Địa chỉ, quận/huyện và loại nhà</li>
                    <li>Ảnh và mô tả do chủ nhà cung cấp</li>
                    <li>Tình trạng hiện tại của căn nhà</li>
                </ul>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="panel">
                <h2>Số liệu hiện tại</h2>
                <dl class="fact-list">
                    <div><dt>Tin cho thuê</dt><dd>@ViewBag.TotalHouses</dd></div>
                    <div><dt>Loại nhà</dt><dd>@ViewBag.TotalCategories</dd></div>
                    <div><dt>Yêu cầu xem nhà đã nhận</dt><dd>@ViewBag.TotalRequests</dd></div>
                </dl>
                <a href="@Url.Action("Search", "House", new { onlyAvailable = "true" })" class="btn btn-primary mt-3">Xem nhà còn trống</a>
            </div>
        </div>
    </div>
</div>
