@model RentHouseMVC.Models.ViewModels.HouseListViewModel
@{
    ViewBag.Title = Model.PageTitle;
    int? currentId = Model.CurrentCategoryId;
}

<section class="page-banner">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                @if (Model.CurrentCategory != null)
                {
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "House", new { id = "" })">Nhà cho thuê</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.CurrentCategory.CatName</li>
                }
                else
                {
                    <li class="breadcrumb-item active" aria-current="page">Nhà cho thuê</li>
                }
            </ol>
        </nav>
        <h1>@Model.PageTitle</h1>
        <p class="mb-0">
            Có <strong>@Model.Houses.TotalItemCount</strong> nhà
            @if (Model.CurrentCategory != null)
            {
                <span>thuộc loại "@Model.CurrentCategory.CatName"</span>
            }
            đang được đăng trên RentHouse.
        </p>
    </div>
</section>

<div class="container section pt-4">
    <!-- Lọc nhanh theo loại nhà -->
    <div class="category-pills mb-4">
        <a href="@Url.Action("Index", "House", new { id = "" })" class="pill @(currentId == null ? "active" : "")">
            <i class="bi bi-grid"></i> Tất cả
        </a>
        @foreach (var c in Model.Categories)
        {
            <a href="@Url.Action("Index", "House", new { id = c.Id })" class="pill @(currentId == c.Id ? "active" : "")">
                <i class="bi @DisplayHelper.CategoryIcon(c.CatName)"></i> @c.CatName <span class="pill-count">@c.HouseCount</span>
            </a>
        }
        <a href="@Url.Action("Search", "House", new { catId = currentId })" class="pill pill-outline ms-md-auto">
            <i class="bi bi-sliders"></i> Lọc nâng cao
        </a>
    </div>

    @if (Model.Houses.TotalItemCount == 0)
    {
        <div class="empty-state">
            <i class="bi bi-house-x"></i>
            <p>Chưa có nhà nào trong mục này.</p>
            <a href="@Url.Action("Index", "House", new { id = "" })" class="btn btn-primary">Xem tất cả nhà</a>
        </div>
    }
    else
    {
        <p class="text-muted small mb-3">
            Hiển thị @Model.Houses.FirstItemOnPage - @Model.Houses.LastItemOnPage trên tổng số @Model.Houses.TotalItemCount nhà
            (trang @Model.Houses.PageNumber/@Model.Houses.PageCount)
        </p>
        <div class="row g-4">
            @foreach (var house in Model.Houses)
            {
                <div class="col-md-6 col-lg-4">
                    @Html.Partial("_HouseCard", house)
                </div>
            }
        </div>

        @Html.Partial("_Pager", new PagerModel(Model.Houses.PageNumber, Model.Houses.PageCount,
            p => Url.Action("Index", "House", new { id = currentId, page = p })))
    }
</div>
