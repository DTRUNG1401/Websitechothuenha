@model RentHouseMVC.Models.ViewModels.HouseSearchViewModel
@{
    ViewBag.Title = "Tìm nhà cho thuê";
    var results = Model.Results;
    string keyword = string.IsNullOrWhiteSpace(Model.Keyword) ? null : Model.Keyword.Trim();
}

<div class="page-head">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Tìm kiếm</li>
            </ol>
        </nav>
        <h1>Tìm nhà cho thuê</h1>
    </div>
</div>

<div class="container">
    <div class="row g-4 listing-layout">
        <aside class="col-lg-3" aria-label="Bộ lọc">
            @Html.Partial("_HouseFilter", Model)
        </aside>

        <div class="col-lg-9">
            <div class="results-bar">
                <p class="results-count">
                    <strong>@results.TotalItemCount</strong> nhà
                    @if (keyword != null)
                    {
                        <span>cho "@keyword"</span>
                    }
                </p>
                <div class="results-tools">
                    <button type="button" class="btn btn-outline-secondary btn-sm d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#filterPanel" aria-controls="filterPanel">Bộ lọc</button>
                    <form action="@Url.Action("Search", "House")" method="get" class="sort-form">
                        @foreach (var item in Model.ToRouteValues(1))
                        {
                            if (item.Key != "sort")
                            {
                                <input type="hidden" name="@item.Key" value="@item.Value" />
                            }
                        }
                        <label for="sort">Sắp xếp</label>
                        <select id="sort" name="sort" class="form-select form-select-sm" data-auto-submit="true">
                            @foreach (var item in SearchOptions.SortItems(Model.Sort))
                            {
                                <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                            }
                        </select>
                        <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">Áp dụng</button></noscript>
                    </form>
                </div>
            </div>

            @if (results.TotalItemCount == 0)
            {
                <div class="empty-state">
                    <h2>Không có nhà phù hợp</h2>
                    <p class="mb-3">Thử bỏ bớt điều kiện lọc hoặc đổi từ khóa.</p>
                    <a href="@Url.Action("Search", "House")" class="btn btn-outline-primary">Xóa bộ lọc</a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var house in results)
                    {
                        <div class="col-sm-6 col-xl-4">
                            @Html.Partial("_HouseCard", house)
                        </div>
                    }
                </div>

                @Html.Partial("_Pager", new PagerModel(results.PageNumber, results.PageCount,
                    p => Url.Action("Search", "House", Model.ToRouteValues(p))))
            }
        </div>
    </div>
</div>
