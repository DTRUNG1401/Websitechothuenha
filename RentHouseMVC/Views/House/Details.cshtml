@model RentHouseMVC.Models.ViewModels.HouseDetailsViewModel
@{
    var house = Model.House;
    ViewBag.Title = house.Title;
    string requestSuccess = TempData["RequestSuccess"] as string;
    bool hasFormError = !ViewData.ModelState.IsValid;
    bool rented = house.Status != HouseStatus.Available;
    // Thời điểm sớm nhất được chọn trên ô ngày giờ (định dạng của input datetime-local)
    string minViewingDate = DateTime.Now.ToString("yyyy-MM-dd'T'HH:mm", System.Globalization.CultureInfo.InvariantCulture);
}

<div class="container pt-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "House", new { id = house.CatId })">@house.Category.CatName</a></li>
            <li class="breadcrumb-item active text-truncate" aria-current="page">@house.Title</li>
        </ol>
    </nav>
</div>

<div class="container pb-2">
    <div class="row g-4 g-lg-5">
        <!-- ===== THÔNG TIN NHÀ ===== -->
        <div class="col-lg-8">
            <figure class="detail-photo">
                <img src="@Url.HouseImage(house.Image)" alt="@house.Title" />
                @if (rented)
                {
                    <span class="listing-flag">@house.Status</span>
                }
            </figure>

            <header class="detail-head">
                <h1>@house.Title</h1>
                <p class="detail-address"><i class="bi bi-geo-alt" aria-hidden="true"></i>@house.Address, @house.District, TP. Hồ Chí Minh</p>
            </header>

            <ul class="detail-facts">
                <li><i class="bi bi-aspect-ratio" aria-hidden="true"></i>@DisplayHelper.FormatAcreage(house.Acreage)</li>
                <li><i class="bi bi-door-closed" aria-hidden="true"></i>@house.Bedrooms phòng ngủ</li>
                <li><i class="bi bi-geo" aria-hidden="true"></i>@house.District</li>
            </ul>

            <section class="detail-section" aria-labelledby="spec-title">
                <h2 id="spec-title">Thông tin chính</h2>
                <dl class="spec-list">
                    <div><dt>Giá thuê</dt><dd>@DisplayHelper.FormatPrice(house.Price)</dd></div>
                    <div><dt>Diện tích</dt><dd>@DisplayHelper.FormatAcreage(house.Acreage)</dd></div>
                    <div><dt>Phòng ngủ</dt><dd>@house.Bedrooms</dd></div>
                    <div><dt>Loại nhà</dt><dd>@house.Category.CatName</dd></div>
                    <div><dt>Quận, huyện</dt><dd>@house.District</dd></div>
                    <div><dt>Tình trạng</dt><dd>@house.Status</dd></div>
                    <div><dt>Ngày đăng</dt><dd>@DisplayHelper.FormatDate(house.PostedDate)</dd></div>
                    <div><dt>Mã tin</dt><dd>@house.HouseId</dd></div>
                </dl>
            </section>

            <section class="detail-section" aria-labelledby="desc-title">
                <h2 id="desc-title">Mô tả</h2>
                @if (string.IsNullOrWhiteSpace(house.Description))
                {
                    <p class="text-muted">Chủ nhà chưa thêm mô tả.</p>
                }
                else
                {
                    @* Giữ xuống dòng bằng CSS (white-space: pre-line); Razor tự mã hóa HTML nên chống được XSS *@
                    <div class="detail-description">@house.Description</div>
                }
            </section>
        </div>

        <!-- ===== HỘP ĐẶT LỊCH XEM NHÀ ===== -->
        <div class="col-lg-4">
            <div class="booking-sticky">
                <aside class="booking-box" id="dat-lich" aria-labelledby="booking-title">
                    <p class="booking-price">@DisplayHelper.FormatMoney(house.Price) <span>/tháng</span></p>
                    <p class="booking-sub">@DisplayHelper.FormatAcreage(house.Acreage) · @house.Bedrooms PN · @house.District</p>
                    <hr class="booking-divider" />

                    @if (!string.IsNullOrEmpty(requestSuccess))
                    {
                        <div class="alert alert-success" role="status">@requestSuccess</div>
                    }

                    @if (Model.CanRequest)
                    {
                        <h2 class="booking-title" id="booking-title">Đặt lịch xem nhà</h2>
                        <p class="small text-muted">Chúng tôi gọi lại để xác nhận giờ hẹn.</p>

                        using (Html.BeginForm("SendRequest", "House", FormMethod.Post, new { novalidate = "novalidate", id = "requestForm" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(m => m.RequestForm.HouseId)
                            @Html.ValidationSummary(true, "")

                            <div class="mb-3">
                                @Html.LabelFor(m => m.RequestForm.CustomerName, new { @class = "form-label" })<span class="required-mark" aria-hidden="true">*</span>
                                @Html.TextBoxFor(m => m.RequestForm.CustomerName, new { @class = "form-control", maxlength = "100", autocomplete = "name" })
                                @Html.ValidationMessageFor(m => m.RequestForm.CustomerName)
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(m => m.RequestForm.CustomerPhone, new { @class = "form-label" })<span class="required-mark" aria-hidden="true">*</span>
                                @Html.TextBoxFor(m => m.RequestForm.CustomerPhone, new { @class = "form-control", placeholder = "VD: 0901234567", maxlength = "15", type = "tel", autocomplete = "tel" })
                                @Html.ValidationMessageFor(m => m.RequestForm.CustomerPhone)
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(m => m.RequestForm.CustomerEmail, new { @class = "form-label" }) <span class="text-muted fw-normal small">(không bắt buộc)</span>
                                @Html.TextBoxFor(m => m.RequestForm.CustomerEmail, new { @class = "form-control", maxlength = "100", type = "email", autocomplete = "email", data_msg_email = "Email không hợp lệ" })
                                @Html.ValidationMessageFor(m => m.RequestForm.CustomerEmail)
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(m => m.RequestForm.ViewingDate, new { @class = "form-label" })<span class="required-mark" aria-hidden="true">*</span>
                                @Html.TextBoxFor(m => m.RequestForm.ViewingDate, "{0:yyyy-MM-dd'T'HH:mm}", new { @class = "form-control", type = "datetime-local", min = minViewingDate, data_msg_min = "Ngày giờ xem nhà phải sau thời điểm hiện tại" })
                                @Html.ValidationMessageFor(m => m.RequestForm.ViewingDate)
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(m => m.RequestForm.Note, new { @class = "form-label" }) <span class="text-muted fw-normal small">(không bắt buộc)</span>
                                @Html.TextAreaFor(m => m.RequestForm.Note, new { @class = "form-control", rows = 3, maxlength = "500", placeholder = "VD: Muốn xem buổi tối, có nuôi mèo" })
                                @Html.ValidationMessageFor(m => m.RequestForm.Note)
                            </div>

                            <button type="submit" class="btn btn-accent btn-lg w-100">Gửi yêu cầu</button>
                        }
                    }
                    else
                    {
                        <h2 class="booking-title" id="booking-title">Nhà đã có người thuê</h2>
                        <p class="text-muted mb-3">Căn này không nhận lịch xem nữa. Bạn có thể xem các căn còn trống cùng loại.</p>
                        <a href="@Url.Action("Search", "House", new { catId = house.CatId, onlyAvailable = "true" })" class="btn btn-outline-primary w-100">Xem nhà còn trống</a>
                    }

                    <p class="booking-help">Cần hỗ trợ? Gọi 1900 6868 (8:00 – 21:00).</p>
                </aside>
            </div>
        </div>
    </div>
</div>

<!-- ===== NHÀ CÙNG LOẠI ===== -->
@if (Model.RelatedHouses.Count > 0)
{
    <section class="container section" aria-labelledby="related-title">
        <div class="section-head">
            <h2 id="related-title">@house.Category.CatName khác</h2>
            <a href="@Url.Action("Index", "House", new { id = house.CatId })">Xem tất cả</a>
        </div>
        <div class="row g-4">
            @foreach (var item in Model.RelatedHouses)
            {
                <div class="col-sm-6 col-lg-3">
                    @Html.Partial("_HouseCard", item)
                </div>
            }
        </div>
    </section>
}

@section scripts {
    @Html.Partial("_ValidationScriptsPartial")
    @if (hasFormError)
    {
        <script>
            // Có lỗi nhập liệu: cuộn tới hộp đặt lịch
            document.getElementById('dat-lich').scrollIntoView();
        </script>
    }
}
