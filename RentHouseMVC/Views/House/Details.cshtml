@model RentHouseMVC.Models.ViewModels.HouseDetailsViewModel
@{
    var house = Model.House;
    ViewBag.Title = house.Title;
    string requestSuccess = TempData["RequestSuccess"] as string;
    bool hasFormError = !ViewData.ModelState.IsValid;
    // Thời điểm sớm nhất được chọn trên ô ngày giờ (định dạng của input datetime-local)
    string minViewingDate = DateTime.Now.ToString("yyyy-MM-dd'T'HH:mm", System.Globalization.CultureInfo.InvariantCulture);
}

<div class="container pt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "House", new { id = house.CatId })">@house.Category.CatName</a></li>
            <li class="breadcrumb-item active text-truncate" aria-current="page">@house.Title</li>
        </ol>
    </nav>
</div>

<div class="container pb-4">
    <div class="row g-4">
        <!-- ===== THÔNG TIN NHÀ ===== -->
        <div class="col-lg-8">
            <div class="detail-image ratio ratio-16x9">
                <img src="@Url.HouseImage(house.Image)" alt="@house.Title" />
                <span class="badge house-status fs-6 @DisplayHelper.HouseStatusCss(house.Status)">
                    <i class="bi @(house.Status == HouseStatus.Available ? "bi-check-circle" : "bi-lock")"></i> @house.Status
                </span>
            </div>

            <div class="detail-card mt-4">
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <span class="badge rounded-pill text-bg-light border"><i class="bi @DisplayHelper.CategoryIcon(house.Category.CatName)"></i> @house.Category.CatName</span>
                    <span class="badge rounded-pill text-bg-light border"><i class="bi bi-clock"></i> Đăng @DisplayHelper.TimeAgo(house.PostedDate)</span>
                    <span class="badge rounded-pill text-bg-light border"><i class="bi bi-hash"></i>Mã tin: @house.HouseId</span>
                </div>
                <h1 class="detail-title">@house.Title</h1>
                <p class="detail-address"><i class="bi bi-geo-alt-fill text-danger"></i> @house.Address, @house.District, TP. Hồ Chí Minh</p>

                <div class="detail-price">
                    <span class="label">Giá thuê</span>
                    <span class="value">@DisplayHelper.FormatPrice(house.Price)</span>
                </div>

                <div class="row g-3 detail-facts">
                    <div class="col-6 col-md-3">
                        <div class="fact"><i class="bi bi-aspect-ratio"></i><span>Diện tích</span><strong>@DisplayHelper.FormatAcreage(house.Acreage)</strong></div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="fact"><i class="bi bi-door-closed"></i><span>Phòng ngủ</span><strong>@house.Bedrooms phòng</strong></div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="fact"><i class="bi bi-map"></i><span>Quận/Huyện</span><strong>@house.District</strong></div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="fact"><i class="bi bi-calendar3"></i><span>Ngày đăng</span><strong>@DisplayHelper.FormatDate(house.PostedDate)</strong></div>
                    </div>
                </div>

                <h2 class="h5 mt-4 mb-3">Mô tả chi tiết</h2>
                @if (string.IsNullOrWhiteSpace(house.Description))
                {
                    <p class="text-muted fst-italic">Chưa có mô tả cho căn nhà này.</p>
                }
                else
                {
                    @* Giữ xuống dòng bằng CSS (white-space: pre-line); Razor tự mã hóa HTML nên chống được XSS *@
                    <div class="detail-description">@house.Description</div>
                }

                <h2 class="h5 mt-4 mb-3">Thông tin tổng quan</h2>
                <table class="table table-bordered detail-table mb-0">
                    <tbody>
                        <tr><th scope="row">Loại nhà</th><td>@house.Category.CatName</td></tr>
                        <tr><th scope="row">Địa chỉ</th><td>@house.Address</td></tr>
                        <tr><th scope="row">Quận/Huyện</th><td>@house.District</td></tr>
                        <tr><th scope="row">Giá thuê</th><td>@DisplayHelper.FormatPrice(house.Price)</td></tr>
                        <tr><th scope="row">Diện tích</th><td>@DisplayHelper.FormatAcreage(house.Acreage)</td></tr>
                        <tr><th scope="row">Số phòng ngủ</th><td>@house.Bedrooms</td></tr>
                        <tr>
                            <th scope="row">Trạng thái</th>
                            <td><span class="badge @DisplayHelper.HouseStatusCss(house.Status)">@house.Status</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ===== FORM ĐẶT LỊCH XEM NHÀ ===== -->
        <div class="col-lg-4">
            <div class="request-box" id="dat-lich">
                @if (!string.IsNullOrEmpty(requestSuccess))
                {
                    <div class="alert alert-success d-flex gap-2" role="alert">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                        <div><strong>Đã gửi!</strong><br />@requestSuccess</div>
                    </div>
                }

                @if (Model.CanRequest)
                {
                    <h2 class="h5 mb-1"><i class="bi bi-calendar-check text-primary me-1"></i>Đặt lịch xem nhà</h2>
                    <p class="small text-muted">Điền thông tin, chúng tôi sẽ gọi lại xác nhận trong thời gian sớm nhất.</p>

                    using (Html.BeginForm("SendRequest", "House", FormMethod.Post, new { novalidate = "novalidate", id = "requestForm" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.RequestForm.HouseId)
                        @Html.ValidationSummary(true, "", new { @class = "text-danger small" })

                        <div class="mb-3">
                            @Html.LabelFor(m => m.RequestForm.CustomerName, new { @class = "form-label" }) <span class="text-danger">*</span>
                            @Html.TextBoxFor(m => m.RequestForm.CustomerName, new { @class = "form-control", placeholder = "Nguyễn Văn A", maxlength = "100", autocomplete = "name" })
                            @Html.ValidationMessageFor(m => m.RequestForm.CustomerName)
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.RequestForm.CustomerPhone, new { @class = "form-label" }) <span class="text-danger">*</span>
                            @Html.TextBoxFor(m => m.RequestForm.CustomerPhone, new { @class = "form-control", placeholder = "0901234567", maxlength = "15", type = "tel", autocomplete = "tel" })
                            @Html.ValidationMessageFor(m => m.RequestForm.CustomerPhone)
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.RequestForm.CustomerEmail, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.RequestForm.CustomerEmail, new { @class = "form-control", placeholder = "email@example.com (không bắt buộc)", maxlength = "100", type = "email", autocomplete = "email", data_msg_email = "Email không hợp lệ" })
                            @Html.ValidationMessageFor(m => m.RequestForm.CustomerEmail)
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.RequestForm.ViewingDate, new { @class = "form-label" }) <span class="text-danger">*</span>
                            @Html.TextBoxFor(m => m.RequestForm.ViewingDate, "{0:yyyy-MM-dd'T'HH:mm}", new { @class = "form-control", type = "datetime-local", min = minViewingDate, data_msg_min = "Ngày giờ xem nhà phải sau thời điểm hiện tại" })
                            @Html.ValidationMessageFor(m => m.RequestForm.ViewingDate)
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.RequestForm.Note, new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.RequestForm.Note, new { @class = "form-control", rows = 3, maxlength = "500", placeholder = "Ví dụ: Tôi muốn xem nhà vào buổi tối, có nuôi thú cưng..." })
                            @Html.ValidationMessageFor(m => m.RequestForm.Note)
                        </div>

                        <button type="submit" class="btn btn-accent w-100 btn-lg"><i class="bi bi-send me-1"></i>Gửi yêu cầu</button>
                        <p class="small text-muted mt-2 mb-0"><i class="bi bi-shield-check"></i> Thông tin của bạn chỉ dùng để liên hệ xem nhà.</p>
                    }
                }
                else
                {
                    <div class="rented-box">
                        <i class="bi bi-house-lock"></i>
                        <h2 class="h5">Nhà này đã được cho thuê</h2>
                        <p class="mb-3">Rất tiếc, căn nhà đã có người thuê nên không nhận yêu cầu xem nhà. Bạn có thể tham khảo các nhà tương tự bên dưới.</p>
                        <a href="@Url.Action("Search", "House", new { catId = house.CatId, onlyAvailable = "true" })" class="btn btn-primary">
                            <i class="bi bi-search me-1"></i>Tìm nhà còn trống
                        </a>
                    </div>
                }

                <hr />
                <div class="d-flex align-items-center gap-3">
                    <span class="contact-avatar"><i class="bi bi-headset"></i></span>
                    <div>
                        <div class="small text-muted">Cần hỗ trợ ngay?</div>
                        <strong>Hotline 1900 6868</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== NHÀ CÙNG LOẠI ===== -->
@if (Model.RelatedHouses.Count > 0)
{
    <section class="section section-soft">
        <div class="container">
            <div class="section-heading">
                <div>
                    <span class="section-kicker">Có thể bạn quan tâm</span>
                    <h2>Các nhà cùng loại "@house.Category.CatName"</h2>
                </div>
                <a href="@Url.Action("Index", "House", new { id = house.CatId })" class="btn btn-link fw-semibold">Xem tất cả <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="row g-4">
                @foreach (var item in Model.RelatedHouses)
                {
                    <div class="col-md-6 col-lg-3">
                        @Html.Partial("_HouseCard", item)
                    </div>
                }
            </div>
        </div>
    </section>
}

@section scripts {
    @Html.Partial("_ValidationScriptsPartial")
    @if (hasFormError)
    {
        <script>
            // Có lỗi nhập liệu: cuộn tới form đặt lịch
            document.getElementById('dat-lich').scrollIntoView({ behavior: 'smooth' });
        </script>
    }
}
